# Copia este archivo como .env.local y llénalo. .env.local NUNCA se sube a GitHub.
# Todo sale de supabase.com → tu proyecto "tasa".

# Project Settings → Data API → Project URL  (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API Keys → "Publishable key" (empieza con sb_publishable_).
# También sirve la "anon" de la pestaña Legacy API Keys. Es pública: el RLS la limita.
# NUNCA pegues aquí la "secret" ni la "service_role".
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → General → Project ID
SUPABASE_PROJECT_REF=

# La contraseña de la base que pusiste al crear el proyecto.
# Si no la tienes: Project Settings → Database → Reset database password.
SUPABASE_DB_PASSWORD=

# pruebas = se permiten semilla y verificaciones.
# produccion = lo pone solo `npm run db:reset-produccion`. No lo cambies a mano.
TASA_MODO=pruebas
