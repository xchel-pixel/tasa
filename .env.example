# Copia este archivo como .env.local y llénalo. .env.local NUNCA se sube a GitHub.

# --- Aplicación (en Vercel van las de producción) ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- CLI de Supabase (solo en tu computadora) ---
# Ref = Project ID: Settings → General. También es lo que va en https://<ref>.supabase.co
# Password = la contraseña de la base que pusiste al crear el proyecto.
#   Si no la tienes: Settings → Database → Reset database password.
SUPABASE_REF_PRUEBAS=
SUPABASE_DB_PASSWORD_PRUEBAS=
SUPABASE_REF_PRODUCCION=
SUPABASE_DB_PASSWORD_PRODUCCION=
